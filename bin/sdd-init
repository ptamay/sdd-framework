#!/usr/bin/env node
// Bootstrap de projeto — cria o minimo que o framework precisa DENTRO do repositorio.
//
//   sdd-init [caminho-do-projeto]
//
// Sao poucos arquivos de proposito. No v5 o bootstrap copiava o framework inteiro para
// dentro de cada projeto — 76 arquivos — e daquilo nasceram o selo, o manifesto, os guards,
// a caca a copias orfas e cerca de mil e duzentas linhas de codigo cuja unica funcao era
// defender o framework de si mesmo. Aqui o framework mora no plugin; o projeto so guarda o
// que e DELE: memoria, valvulas e o enforcement que roda no servidor.
//
// Duas regras de comportamento:
//
//   NUNCA SOBRESCREVE   arquivo que ja existe e reportado como preservado. Bootstrap que
//                       apaga trabalho e bootstrap que ninguem roda duas vezes.
//   VERIFICA O PRODUTO  ao terminar, roda os gates no projeto recem-criado e imprime o
//                       resultado. O v5 registrou (item 207) que TODO projeto que ele criava
//                       nascia reprovado, por um defeito que o autoteste do framework nao
//                       via: fixture de gate prova o gate, so rodar o bootstrap prova o
//                       bootstrap.

import { mkdir, writeFile, access, readFile } from 'node:fs/promises';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { join, dirname } from 'node:path';

import { raizDoRepo, gatesAtivos } from '../gates/lib/policy.mjs';
import { executarTodos, formatar, lerValvulas, lerIsencoes } from '../gates/run.mjs';

const projeto = process.argv[2] ?? process.cwd();
const FRAMEWORK = raizDoRepo();

const memoria = JSON.parse(await readFile(join(FRAMEWORK, 'policy', 'memoria.json'), 'utf8'));
const catalogo = JSON.parse(await readFile(join(FRAMEWORK, 'policy', 'gates.json'), 'utf8'));
const { version: versaoDoPlugin } = JSON.parse(
  await readFile(join(FRAMEWORK, '.claude-plugin', 'plugin.json'), 'utf8'),
);

// Sem `SDD_ORIGEM` o job de CI nasce com este marcador no lugar da URL do framework, e nao
// roda. Falhar alto e o comportamento certo; o defeito era outro — a primeira execucao real
// do bootstrap declarou dois passos manuais e OMITIU este, entao o usuario recebeu
// "bootstrap concluido" com um CI que nao clona nada. Lacuna omitida vira "achavamos que
// estava protegido", que e a frase que o gate `context` existe para nunca precisar.
const PLACEHOLDER_ORIGEM = '<URL-DO-REPOSITORIO-DO-FRAMEWORK>';

const exec = promisify(execFile);

// O gatilho de push do CI vinha fixado em `main`. Num repositorio `master` — o default de
// quem nunca mexeu na config do git — o job nunca dispara nesse eixo, e sobra so o de
// pull_request. Enforcement que silenciosamente nao roda e o defeito que este arquivo
// inteiro existe para nao cometer, e ele estava escrito na linha 153.
const branchPadrao = await detectarBranchPadrao();

// Mesma classe do branch: exigir que o usuario DIGITE `SDD_ORIGEM` toda vez e um passo
// manual que ninguem lembra na segunda execucao. O FRAMEWORK sabe a propria URL — ele e um
// repositorio git, e uma vez publicado tem `origin`. Perguntar a ele em vez de perguntar ao
// usuario transforma "lembre de passar a URL" em "publique o framework uma vez".
const origemDoFramework = await detectarOrigemDoFramework();

const criados = [];
const preservados = [];

for (const [caminho, conteudo] of Object.entries(await arquivos())) {
  const destino = join(projeto, caminho);
  if (await existe(destino)) {
    preservados.push(caminho);
    continue;
  }
  await mkdir(dirname(destino), { recursive: true });
  await writeFile(destino, conteudo);
  criados.push(caminho);
}

console.log('# Bootstrap do projeto\n');
for (const c of criados) console.log(`  criado     ${c}`);
for (const p of preservados) console.log(`  preservado ${p}`);

if (!criados.length) console.log('  (nada a criar — o projeto ja estava montado)');

console.log('\n# Verificacao — os gates no projeto recem-criado\n');
const relatorio = await executarTodos({
  raiz: projeto,
  valvulas: await lerValvulas(projeto),
  isencoes: await lerIsencoes(projeto),
});
console.log(formatar(relatorio));

if (relatorio.veredito === 'reprovado') {
  console.log('\nO BOOTSTRAP PRODUZIU UM PROJETO REPROVADO. Isto e defeito do framework,');
  console.log('nao seu — reporte. (No v5 isto aconteceu com todo projeto criado, por tres');
  console.log('versoes, porque ninguem verificava o produto do bootstrap.)');
  process.exit(1);
}

console.log('\n# Proximo passo\n');
console.log('  /sdd:escopo        define o que o sistema faz');

// A lista e MONTADA, nunca numerada a mao. Item condicional com numero fixo escrito ao lado
// ja produziu, na primeira versao deste relatorio, um "1." sozinho — e o "2." que faltava
// era justamente a lacuna que o texto existia para declarar.
const manuais = [
  [
    'Ligue a protecao de branch no repositorio remoto. O job de CI so vira barreira',
    'quando ela existe — sem ela, o check fica vermelho e o merge acontece assim mesmo.',
  ],
];

// A pergunta e feita ao ARQUIVO, nunca a variavel de ambiente. O CI e preservado quando ja
// existe, entao um `SDD_ORIGEM` setado nesta execucao nao diz nada sobre o que esta gravado
// de uma execucao anterior — e o usuario pode ter preenchido a URL a mao no meio tempo. O
// bootstrap ja verifica o proprio produto rodando os gates contra ele; isto e a mesma regra.
if (await placeholderVivo()) {
  manuais.push(
    origemDoFramework
      ? [
          'Preencha a origem do framework em .github/workflows/ci.yml — o passo "Obter o',
          `framework" esta com ${PLACEHOLDER_ORIGEM} no lugar da URL.`,
          `O framework local ja aponta para ${origemDoFramework} — para os proximos`,
          'projetos, deletar o placeholder e rodar `sdd-init` de novo preenche sozinho.',
        ]
      : [
          'Preencha a origem do framework em .github/workflows/ci.yml — o passo "Obter o',
          `framework" esta com ${PLACEHOLDER_ORIGEM} no lugar da URL.`,
          'Como esta, o job FALHA no clone e nenhum gate roda no servidor. O framework',
          'local nao tem remote configurado, entao nao ha URL para detectar sozinho —',
          'publique-o e rode `sdd-init` de novo, ou preencha esta linha a mao.',
        ],
  );
}

if (!branchPadrao.detectado) {
  manuais.push([
    'Confira o gatilho de push em .github/workflows/ci.yml. Nao deu para detectar o',
    `branch default deste repositorio, entao ficou "${branchPadrao.branch}" por padrao.`,
    'Se o seu for outro, o job nunca dispara nesse eixo.',
  ]);
}

const lacunaDeEol = await gitattributesDescoberto();
if (lacunaDeEol) manuais.push(lacunaDeEol);

console.log('\nPassos MANUAIS que nenhum gate cobre:\n');
manuais.forEach((linhas, i) => {
  console.log(`${i + 1}. ${linhas[0]}`);
  for (const l of linhas.slice(1)) console.log(`   ${l}`);
  if (i < manuais.length - 1) console.log('');
});

// ---------------------------------------------------------------------------

async function existe(c) {
  return access(c).then(() => true, () => false);
}

/**
 * Qual branch o gatilho de push do CI deve observar?
 *
 * Duas fontes, nesta ordem, e a ordem e o ponto:
 *
 *   remote   `origin/HEAD` e a resposta AUTORITATIVA — e o default que o servidor publica,
 *            que e exatamente onde o job vai rodar.
 *   local    o branch atual. Num repositorio recem-criado ele E o default por construcao,
 *            que e o caso normal de quem roda o bootstrap.
 *
 * Falhou tudo (nao e repo git, HEAD destacado): cai em `main` e DECLARA. Chutar em silencio
 * aqui produz um CI que existe, aparece na aba de Actions e nunca dispara.
 *
 * Limite conhecido: rodar o bootstrap de dentro de um branch de trabalho, num repo sem
 * remote, grava aquele branch. E visivel no arquivo gerado e o passo manual de protecao de
 * branch leva o usuario ali de qualquer forma.
 */
async function detectarBranchPadrao() {
  const git = async (...args) =>
    exec('git', args, { cwd: projeto }).then((r) => r.stdout.trim(), () => null);

  const remoto = await git('symbolic-ref', '--short', 'refs/remotes/origin/HEAD');
  if (remoto) return { branch: remoto.replace(/^origin\//, ''), detectado: true };

  const local = await git('symbolic-ref', '--short', 'HEAD');
  if (local) return { branch: local, detectado: true };

  return { branch: 'main', detectado: false };
}

/**
 * `.gitattributes` preservado que nao cobre `.sdd/` e pior que ausente: ele existe, parece
 * cuidado tomado, e deixa passar exatamente os arquivos que o framework le.
 */
async function gitattributesDescoberto() {
  if (!preservados.includes('.gitattributes')) return null;

  const texto = await readFile(join(projeto, '.gitattributes'), 'utf8').catch(() => null);
  if (texto === null || texto.includes('.sdd/')) return null;

  return [
    'Seu .gitattributes foi preservado e nao menciona `.sdd/`. Acrescente',
    '`.sdd/** text eol=lf` — sem isso, em Windows os arquivos de memoria entram no git',
    'com CRLF, e um \\r no fim da linha nao aparece em leitura nenhuma.',
  ];
}

/**
 * URL do `origin` do PROPRIO framework — nao do projeto sendo criado.
 *
 * `git remote get-url` falha (exit != 0) tanto quando o framework nao e um repositorio git
 * quanto quando e um repositorio sem remote configurado. As duas sao "nao sei", nunca "e
 * vazio": tratadas iguais, caem para SDD_ORIGEM ou para o placeholder.
 */
async function detectarOrigemDoFramework() {
  return exec('git', ['remote', 'get-url', 'origin'], { cwd: FRAMEWORK }).then(
    (r) => r.stdout.trim() || null,
    () => null,
  );
}

/** O job de CI gravado neste projeto ainda tem o marcador no lugar da URL? */
async function placeholderVivo() {
  const alvo = join(projeto, '.github', 'workflows', 'ci.yml');
  const texto = await readFile(alvo, 'utf8').catch(() => null);
  // Arquivo ilegivel NAO vira "esta preenchido": nao saber e diferente de estar em ordem.
  if (texto === null) return false;
  return texto.includes(PLACEHOLDER_ORIGEM);
}

async function arquivos() {
  const min = catalogo.gates.find((g) => g.id === 'coverage').minimoPadrao;

  return {
    // Marcador EXPLICITO. `.sdd/` sozinho nao serve: a versao anterior deste framework
    // tambem usa esse diretorio, entao um projeto v5 seria lido como projeto v6 e receberia
    // o processo errado injetado na sessao. Marcador ambiguo e pior que marcador nenhum —
    // ele da uma resposta, e a resposta esta errada.
    '.sdd/framework.json': JSON.stringify(
      { framework: 'sdd', versao: versaoDoPlugin, criado: new Date().toISOString().slice(0, 10) },
      null,
      2,
    ) + '\n',
    [`${memoria.raiz}/LEIA.md`]: guiaDaMemoria(),
    '.sdd/coverage-min': `${min}\n`,
    '.github/workflows/ci.yml': ci(),
    '.claude/settings.json': settings(),
    '.gitattributes': gitattributes(),
  };
}

/**
 * Fim de linha do que O FRAMEWORK le, e SO disso.
 *
 * O escopo e a decisao aqui. Um `* text=auto` imporia a convencao do framework ao codigo do
 * usuario, que nao e nosso para decidir — a stack dele pode ter motivo proprio. O que e
 * nosso sao `.sdd/` e o job de CI.
 *
 * A licao vem de duas ocorrencias dentro do proprio framework: a conversao CRLF desarmou um
 * gate inteiro (o arquivo parseado vinha com \r colado no fim de cada caminho, nada era
 * encontrado, e o gate reportou tudo como ausente sem comparar um hash), e depois derrubou o
 * frontmatter dos sub-agentes, que passaram a carregar sem `tools` e sem `model`.
 *
 * Aqui o alvo sao os arquivos de memoria que nascem na rota de arquitetura: eles sao lidos,
 * e um `\r` no fim da linha e invisivel em toda leitura humana.
 */
function gitattributes() {
  return `# Fim de linha do que o Constitutional SDD le. Prevencao na origem.
#
# So o que e do framework entra aqui. O codigo do seu projeto segue a convencao que voce
# escolher — esta lista nao opina sobre ele.
#
# No framework, a conversao CRLF ja desarmou um gate inteiro e ja derrubou o frontmatter dos
# sub-agentes, que passaram a carregar sem restricao de ferramenta. Nos dois casos a falha
# foi muda: \\r no fim da linha nao aparece em leitura nenhuma.

.sdd/**                     text eol=lf
.github/workflows/ci.yml    text eol=lf
`;
}

/** O guia da memoria e DERIVADO do contrato. Escrito a mao, ele seria a segunda fonte. */
function guiaDaMemoria() {
  const linhas = [
    '# Memoria do projeto',
    '',
    'Estes arquivos sao a verdade DESTE projeto. O framework mora no plugin, fora daqui.',
    '',
    'Gerado por `sdd-init` a partir do contrato de memoria do framework — nao edite este',
    'guia a mao: ele fica velho e passa a discordar do que os gates cobram.',
    '',
  ];

  for (const a of memoria.arquivos) {
    linhas.push(`## \`${a.arquivo}\``, '');
    linhas.push(`${a.guarda}. Nasce na rota **${a.nasce}**.`, '');
    linhas.push(`- **Regra:** ${a.regra}`);
    linhas.push(`- **Secoes:** ${a.secoes.map((s) => `\`## ${s}\``).join(' · ')}`);
    if (a.porque) linhas.push(`- **Por que:** ${a.porque}`);
    linhas.push('');
  }

  linhas.push('## Valvulas de escape', '');
  linhas.push('Baixar a regua conscientemente e decisao registrada; contornar o gate e');
  linhas.push('divida invisivel. Por isso cada valvula e um ARQUIVO, visivel num diff:', '');
  for (const v of memoria.valvulas) {
    linhas.push(`- \`${v.arquivo}\` (gate \`${v.gate}\`) — ${v.formato}`);
  }

  return linhas.join('\n') + '\n';
}

function ci() {
  // Precedencia: SDD_ORIGEM explicita > remote do framework > placeholder. Explicito vence
  // porque e a unica forma de o usuario apontar para um FORK ou espelho diferente do que o
  // framework local tem configurado — auto-deteccao nunca deve silenciar uma escolha feita
  // a dedo.
  const origem = process.env.SDD_ORIGEM ?? origemDoFramework ?? PLACEHOLDER_ORIGEM;
  return `# Gates do Constitutional SDD.
#
# Este job e o unico enforcement que roda ONDE O AGENTE NAO ESCREVE. Tudo o mais — hook,
# guard, execucao local — roda na mesma maquina, sob o mesmo usuario e com as mesmas
# permissoes de quem gera o codigo. O v5 mediu isso: um agente reescreveu a regra de
# seguranca numero 1, rodou a selagem sozinho, commitou e recebeu aprovacao de todos os
# gates locais.
#
# O framework NAO e copiado para dentro deste repositorio. Ele e clonado no runner, na
# versao fixada abaixo.

name: gates

on:
  pull_request:
  push:
    branches: [${branchPadrao.branch}]

jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      # fetch-depth: 0 NAO e preferencia. O default do actions/checkout e 1 — um commit — e o
      # gate 4 compara o commit de teste com o de implementacao num RANGE de historico. Sem
      # historico ele nao tem o que comparar e sai \`pulado\`, sem reprovar nada: o gate que pega
      # "commitei o teste depois" fica cego exatamente aqui, no unico enforcement que roda onde o
      # agente nao escreve. Medido em projeto real, na primeira vez que este job rodou de verdade.
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Instalar dependencias do projeto
        run: npm ci
        continue-on-error: true

      - name: Suite de teste com cobertura
        run: npm test --if-present

      - name: Obter o framework
        run: git clone --depth 1 ${origem} "\${RUNNER_TEMP}/sdd"

      - name: Gates
        run: node "\${RUNNER_TEMP}/sdd/bin/sdd-gates" .
`;
}

function settings() {
  return (
    JSON.stringify(
      {
        _: 'Permissoes do projeto. Ficam AQUI, e nao no plugin, porque o settings.json de plugin so aceita as chaves de agente e de status line — permissoes nao viajam com ele.',
        permissions: {
          deny: ['Bash(git push --force:*)', 'Bash(git push -f:*)'],
        },
      },
      null,
      2,
    ) + '\n'
  );
}

export { gatesAtivos };
